      "./components/canon-figure.js": "./dist/_app_/components/canon-figure.js",
      "./components/canon-file-cell.js": "./dist/_app_/components/canon-file-cell.js",
      "./components/canon-from-to.js": "./dist/_app_/components/canon-from-to.js",
