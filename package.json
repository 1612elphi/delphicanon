{
  "name": "delphicanon",
  "version": "0.0.0",
  "description": "Canon Delphi Components for Ember, ported from the delphitools iOS app.",
  "keywords": [
    "ember-addon"
  ],
  "repository": "",
  "license": "0BSD",
  "author": "",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"bun:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"bun:lint:*:fix\" --names \"fix:\" --prefixColors auto && bun run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "bun run build && publint run --level error",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "start": "vite dev",
    "showcase": "vite dev --config showcase/vite.config.mjs",
    "build:showcase": "vite build --config showcase/vite.config.mjs",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9",
    "decorator-transforms": "^2.2.2",
    "ember-modifier": "^4.3.0",
    "lucide-static": "^1.30.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/library-tsconfig": "^1.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/addon-dev": "^8.1.0",
    "@embroider/compat": "^4.1.20",
    "@embroider/core": "^4.6.1",
    "@embroider/macros": "^1.20.4",
    "@embroider/vite": "^1.7.7",
    "@eslint/js": "^9.39.4",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.8.1",
    "@glint/template": "^1.7.8",
    "@glint/tsserver-plugin": "^2.5.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.14",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.3",
    "decorator-transforms": "^2.3.2",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-source": "~7.1.0",
    "ember-strict-application-resolver": "^0.1.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.4",
    "prettier-plugin-ember-template-tag": "^2.1.6",
    "publint": "^0.3.16",
    "puppeteer-core": "^25.5.0",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.5.1",
    "rollup": "^4.22.5",
    "testem": "^3.20.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
